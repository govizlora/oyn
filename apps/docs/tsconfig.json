{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": { "@/components/ui/oyn/*": ["../../registry/ceramic/*"] },
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
