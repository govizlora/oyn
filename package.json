{
  "name": "oyn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/benchmark.mjs",
    "dev:mui": "npm run dev -w @oyn/example-mui",
    "dev:shadcn": "npm run dev -w @oyn/example-shadcn",
    "build:all": "npm run build:packages && npm run build && npm run build -w @oyn/example-mui -w @oyn/example-shadcn -w @oyn/example-shadcn-surface",
    "build:packages": "npm run build -w @oyn/surface && npm run build -w @oyn/material-ceramic",
    "test:ceramic": "npm run build:packages && node tests/ceramic.mjs",
    "test:theme": "node tests/theme.mjs",
    "test:examples": "node tests/examples.mjs",
    "dev:shadcn-surface": "npm run dev -w @oyn/example-shadcn-surface",
    "test:shadcn-surface": "node tests/shadcn-surface.mjs && node tests/surface-dialog-position.mjs",
    "test:surface-core": "npm run build:packages && node tests/surface-core.mjs",
    "test:benchmark": "node tests/benchmark.mjs",
    "test:performance": "node tests/webgpu-performance.mjs",
    "test:visual": "node tests/webgpu-visual.mjs",
    "test:lifecycle": "node tests/webgpu-lifecycle.mjs",
    "test:surface-dialog": "node tests/surface-dialog.mjs",
    "test:surface-theme": "npm run build:packages && node tests/surface-theme.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
